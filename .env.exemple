# env usado na network docker chamando yarn start
# note que o dominio é o nome do service e a porta é a exposed no na imagem do gateway
GATEWAY_URL="http://kozz-gw:4521"
# nome da boundary precisa coincidir com o projeto de modulos do bot.
BOUNDARY_NAME=MinhaBoundary-Wa
# namespace que isola essa boundary no gateway.
KOZZ_NAMESPACE=default
# opcional: use quando quiser rodar mais de uma instancia no mesmo namespace ou controlar o diretorio local.
# BAILEYS_INSTANCE_ID=minha-boundary-default
# BAILEYS_INSTANCE_DIR=./instances/minha-boundary-default
